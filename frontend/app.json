{
  "expo": {
    "name": "DLand",
    "slug": "dland",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dland.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.dland.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "DLand needs access to your photos to add pictures of your land and your profile.",
          "cameraPermission": "DLand needs the camera to photograph your land and documents."
        }
      ],
      "expo-document-picker",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1B7F5A",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "dland"
  }
}
