# --- Server ---
PORT=4000
NODE_ENV=development
# Public base URL used to build links to uploaded files (use your LAN IP so a phone can reach it)
PUBLIC_URL=http://192.168.1.10:4000
CORS_ORIGIN=*

# --- Database ---
DATABASE_URL=postgresql://postgres:12345@localhost:5432/dland

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- Blockchain ledger ---
# Proof-of-work difficulty (number of leading zero hex chars in each block hash)
CHAIN_DIFFICULTY=3
# Ed25519 private key (PEM, base64-encoded) used by the registry authority to sign blocks.
# Leave empty in development: a key is generated in .keys/ on first start.
CHAIN_SIGNER_PRIVATE_KEY_B64=

# --- Optional: anchor every block hash on a public EVM chain (e.g. Polygon Amoy) ---
ANCHOR_ENABLED=false
ANCHOR_RPC_URL=
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=

# --- Uploads ---
MAX_UPLOAD_MB=10
# Private documents (title deeds, IDs, receipts) are stored outside the public /uploads folder
# and opened through signed links that expire. Defaults: backend/storage/private, 300 seconds.
PRIVATE_STORAGE_DIR=
# Secret used to sign document links (at least 16 characters). Defaults to one derived from JWT_ACCESS_SECRET.
FILES_SIGNING_SECRET=
FILE_LINK_TTL_SECONDS=300
